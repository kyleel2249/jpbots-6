{
  "name": "jp-bots-6",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck:worker": "tsc --noEmit -p backend/tsconfig.json",
    "dev:backend": "wrangler dev --local --port 8787",
    "deploy:backend": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply jp-bots-6 --local",
    "db:remote": "wrangler d1 migrations apply jp-bots-6 --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.2.2",
    "typescript": "^5.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.10.2",
    "vitest": "^5.1.2",
    "jsdom": "^27.2.0",
    "wrangler": "^4.0.0"
  }
}
