# Frontend uses the same-origin Cloudflare Pages API proxy by default.
# In local development, Vite proxies /api to the local Worker on 127.0.0.1:8787.
VITE_API_BASE=
# Backend Worker secrets belong in Cloudflare Worker secrets, never this file.
# LIVE_TRADING_ENABLED is hard-locked to false in this release.
LIVE_TRADING_ENABLED=false
